#!/bin/sh
# Run a Python script in a throwaway container on the GPU server.
# Usage: ./run <script>.py [args...]   (image b3d-fasterrcnn, built from ./Dockerfile)
set -eu
cd "$(dirname "$0")"
# ponytail: host paths default to ace's layout; override DATA on other servers.
DATA=${DATA:-/data/cwkt/data}
mkdir -p "$DATA/tetris-annotate"
# Without linger (bombe), the rootless daemon restarts with each SSH login; wait up to 30 s for it.
i=0; until docker info >/dev/null 2>&1; do i=$((i + 1)); [ $i -le 30 ] || { echo "docker daemon not reachable" >&2; exit 1; }; sleep 1; done
# Docker on ace is rootless, so container root writes files as the host user.
docker run --rm --gpus all --shm-size 16g -e CUDA_VISIBLE_DEVICES \
  -v "$PWD:/work" -w /work \
  -v "$DATA/polyis-data/sources:/sources:ro" \
  -v "$DATA/tetris-annotate:/out" \
  -v "$HOME/.netrc:/root/.netrc:ro" \
  "${IMAGE:-b3d-fasterrcnn}" python "$@"
